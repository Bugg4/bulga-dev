---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../config";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) =>
    b.data.publishedAt.getTime() - a.data.publishedAt.getTime() ||
    b.data.postNumber - a.data.postNumber,
);

const pad = (n: number) => String(n).padStart(3, "0");
const dateIso = (d: Date) => d.toISOString().slice(0, 10);
---

<BaseLayout
  title={`Blog — ${site.title}`}
  description={site.description}
  canonicalPath="/blog"
  rssHref="/blog/rss.xml"
  footerRssHref="/blog/rss.xml"
  nav={[{ href: "/blog", label: "Blog" }, { href: "/cv", label: "CV" }, { href: "/contact", label: "Contact" }]}
  upHref="/"
  upLabel="Home"
>
  <article id="post-000">
    <header>
      <h1>
        <span class="blog-title gradient">Blog</span><br />
        <span class="blog-subtitle">List of my posts</span>
      </h1>
      <div class="blog-metadata">
        <ul>
          <li class="author">{site.author}</li>
        </ul>
      </div>
    </header>
    <main>
      <ul class="post-index">
        {
          posts.map((post) => (
            <li>
              <a href={`/blog/post/${post.data.slug}.html#post-${pad(post.data.postNumber)}`}>
                {pad(post.data.postNumber)}: {post.data.title} —{" "}
                {post.data.subtitle}
              </a>{" "}
              <span class="post-index-meta">
                {dateIso(post.data.publishedAt)} · {post.data.readTimeMinutes}{" "}
                min read · {post.data.tags.join(", ")}
              </span>
            </li>
          ))
        }
      </ul>
    </main>
  </article>
</BaseLayout>
