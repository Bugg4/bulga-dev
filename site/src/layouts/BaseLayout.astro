---
import "../styles/blog.css";
import { site } from "../config";

export interface NavItem {
  href: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  ogType?: "website" | "article";
  publishedAt?: Date;
  upHref?: string;
  upLabel?: string;
  nav?: NavItem[];
  rssHref?: string;
  footerRssHref?: string;
}

const {
  title,
  description,
  canonicalPath,
  ogType = "website",
  publishedAt,
  upHref,
  upLabel = "cd ..",
  nav = [],
  rssHref = "/blog/rss.xml",
  footerRssHref = "/blog/rss.xml",
} = Astro.props;
const canonicalUrl = new URL(canonicalPath, site.url).toString();
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.title} — Blog`}
      href={rssHref}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    {
      publishedAt && (
        <meta
          property="article:published_time"
          content={publishedAt.toISOString()}
        />
      )
    }
  </head>
  <body>
    <nav aria-label="Site">
      <a href="/" class="nav-brand">Home</a>
      {nav.length > 0 && (
        <ul class="nav-links">
          {nav.map((item) => (
            <li>
              <a href={item.href} class="nav-link">{item.label}</a>
            </li>
          ))}
        </ul>
      )}
      {
        upHref ? (
          <a href={upHref} class="nav-link">
            {upLabel}
          </a>
        ) : (
          <span class="nav-link" aria-hidden="true">
            {upLabel}
          </span>
        )
      }
    </nav>
    <slot />
    <footer>
      <p class="footer-copy">
        © {year} {site.author}. All rights reserved.
      </p>
      <ul class="footer-links">
        <li>
          <a href={site.githubUrl} aria-label="GitHub">GitHub</a>
        </li>
        <li>
          <a href={footerRssHref} aria-label="RSS">RSS</a>
        </li>
      </ul>
    </footer>
  </body>
</html>
